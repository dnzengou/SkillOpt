# Copy to .env — never commit

# Required
FLY_TOKEN=fm2_replace_me
API_TOKEN=change-me-in-production

# GTM Engine targets (comma-separated)
GTM_TARGETS=yourapp.com,api.yourapp.com,docs.yourapp.com

# Security Agent targets (comma-separated)
SECURITY_TARGETS=yourapp.com,api.yourapp.com,admin.yourapp.com

# Notifications
SLACK_WEBHOOK=https://hooks.slack.com/services/...
RESEND_KEY=re_...
PAGERDUTY_KEY=...
GITHUB_TOKEN=ghp_...
APOLLO_KEY=...

# LLM
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1

# CORS — set to your dashboard domain in production
CORS_ORIGIN=*

# Rate limiting (security-agent)
RATE_LIMIT_PER_MINUTE=10

# Database (auto-set per service, override if needed)
# DATABASE_URL=sqlite://custom.db
