# Vercel env vars for the Clow landing (clow_landing.html + api/*).
# Copy VALUES into: Vercel dashboard → Project → Settings → Environment Variables.
# Never commit filled values.

# ── Waitlist storage (required for /api/waitlist to persist rows) ────
AIRTABLE_API_KEY=pat_replace_me
AIRTABLE_BASE_ID=app_replace_me
AIRTABLE_TABLE=Waitlist

# ── GTM Engine forward (optional — landing forwards signups for ICP scoring) ──
# Landing writes to Airtable regardless; this is a best-effort side-channel.
GTM_ENGINE_URL=https://gtm-engine.fly.dev
GTM_ENGINE_TOKEN=match-the-API_TOKEN-you-set-on-gtm-engine
